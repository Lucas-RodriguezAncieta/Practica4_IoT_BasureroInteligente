
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GestionarUsuariosAlexa",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:AWS_ACCOUNT_ID:table/basurero_usuarios"
    },
    {
      "Sid": "ConsultarYActualizarBasureros",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeThing",
        "iot:GetThingShadow",
        "iot:UpdateThingShadow"
      ],
      "Resource": "arn:aws:iot:us-east-2:AWS_ACCOUNT_ID:thing/basurero-*"
    }
  ]
}
